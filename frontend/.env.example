# Frontend environment overrides. Copy to `.env` and adjust as needed.

# How the login screen behaves. One of: password | sso | both
VITE_AUTH_TYPE=both

# Comma-separated SSO providers to surface on the login screen.
# Options: google, microsoft, github
VITE_SSO_PROVIDERS=google,microsoft,github

# Backend URL used by the dev proxy (requests go to /api by default).
VITE_BACKEND_URL=http://localhost:5000

# Optional explicit API base path. Defaults to "/api" so the Vite proxy handles
# dev and a same-origin deployment handles production.
VITE_API_URL=/api
