generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  displayName String?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  active       Boolean   @default(true)
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  sessions     Session[]
  invites      Invite[]
  evidenceUploads Evidence[]
  passwordResets PasswordReset[]
  auditLogs     AuditLog[]
  assessments  Assessment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[] @relation("RolePermissions")

  @@index([name])
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  roles       Role[] @relation("RolePermissions")

  @@index([name])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Control {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  status      String   @default("not_implemented")
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  evidences   Evidence[]
  assessments Assessment[]
  frameworkMappings Mapping[]

  @@index([category])
  @@index([status])
}

model Policy {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     String?
  status      String   @default("draft")
  version     Int      @default(1)
  rules       Json?
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  evidences   Evidence[]
  versions    PolicyVersion[]
  changeRequests PolicyChangeRequest[]
  reviews     PolicyReview[]
  exceptions  PolicyException[]

  @@index([status])
}

model Evidence {
  id          String    @id @default(cuid())
  title       String
  description String?
  source      String?
  content     String?
  filePath    String?
  mimeType    String?
  status      String    @default("submitted")
  collectedAt DateTime?
  controlId   String?
  policyId     String?
  uploadedById String?
  collectorId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  control     Control?   @relation(fields: [controlId], references: [id], onDelete: SetNull)
  policy      Policy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  uploadedBy  User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  assessmentLinks AssessmentEvidence[]

  @@index([controlId])
  @@index([policyId])
  @@index([source])
  @@index([status])
  @@index([uploadedById])
  @@index([collectorId])
}

model Assessment {
  id             String             @id @default(cuid())
  controlId      String
  result         String
  notes          String?
  assessorId     String?
  assessmentDate DateTime?          @default(now())
  dueDate        DateTime?
  overdueNotified Boolean           @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  control        Control            @relation(fields: [controlId], references: [id], onDelete: Cascade)
  assessor       User?              @relation(fields: [assessorId], references: [id], onDelete: SetNull)
  evidenceLinks  AssessmentEvidence[]

  @@index([controlId])
  @@index([result])
  @@index([dueDate])
}

model AssessmentEvidence {
  assessmentId String
  evidenceId   String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidence     Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([assessmentId, evidenceId])
}

model Framework {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requirements FrameworkRequirement[]

  @@index([enabled])
}

model FrameworkRequirement {
  id          String   @id @default(cuid())
  frameworkId String
  code        String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlMappings Mapping[]

  @@index([frameworkId])
}

model Mapping {
  requirementId String
  controlId     String
  notes         String?
  requirement   FrameworkRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  control       Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@id([requirementId, controlId])
}

// Automated evidence collection configuration. Secrets are stored encrypted in
// the `secrets` column (see src/lib/crypto) so self-hosted teams manage their
// own credentials entirely within the database, with no extra environment
// variables or external secret infrastructure required.
model CollectorConfig {
  id             String   @id @default(cuid())
  name           String
  description    String?
  type           String // 'sql' | future connector types
  enabled        Boolean  @default(false)
  cadenceMinutes Int      @default(360)
  params         Json?
  secrets        String? // encrypted JSON of secret key/values
  lastRunAt      DateTime?
  lastStatus     String? // 'success' | 'error'
  lastError      String?
  nextRunAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
  @@index([nextRunAt])
}

// --- Risk Management ---

model Risk {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  likelihood  Int      @default(1)
  impact      Int      @default(1)
  score       Int      @default(1)
  tolerance   String?
  status      String   @default("open")
  owner       String?
  scenarios   RiskScenario[]
  kris        Kri[]
  treatments  RiskTreatment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model RiskScenario {
  id            String   @id @default(cuid())
  riskId        String
  title         String
  description   String?
  likelihood    Int      @default(1)
  impact        Int      @default(1)
  inherentScore Int      @default(1)
  residualScore Int      @default(1)
  risk          Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([riskId])
}

model Kri {
  id          String    @id @default(cuid())
  riskId      String?
  title       String
  description String?
  unit        String?
  threshold   Float?
  currentValue Float?
  status      String    @default("ok")
  risk        Risk?     @relation(fields: [riskId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([riskId])
  @@index([status])
}

model RiskTreatment {
  id          String   @id @default(cuid())
  riskId      String
  title       String
  description String?
  status      String   @default("planned")
  owner       String?
  dueDate     DateTime?
  risk        Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([riskId])
  @@index([status])
}

// --- Incidents ---

model Incident {
  id              String           @id @default(cuid())
  title           String
  description     String?
  category        String?
  severity        String           @default("low")
  classification  String?
  status          String           @default("open")
  owner           String?
  occurredAt      DateTime?
  resolvedAt      DateTime?
  lessonsLearned  String?
  actions         IncidentAction[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([severity])
}

model IncidentAction {
  id        String    @id @default(cuid())
  incidentId String
  action    String
  owner     String?
  status    String    @default("todo")
  dueDate   DateTime?
  doneAt    DateTime?
  incident Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([incidentId])
}

// --- ITSM ---

model Asset {
  id            String    @id @default(cuid())
  name          String
  type          String?
  description   String?
  owner         String?
  location      String?
  status        String    @default("active")
  purchaseDate  DateTime?
  warrantyExpiry DateTime?
  changes       Change[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type])
  @@index([status])
}

model Change {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("requested")
  risk        String?
  scheduledAt DateTime?
  assetId     String?
  requestedBy String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([assetId])
}

model CapacityPlan {
  id              String   @id @default(cuid())
  resource        String
  unit            String?
  currentCapacity Float?
  plannedCapacity Float?
  asOf            DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([resource])
}

// --- Policy lifecycle extension ---

model PolicyVersion {
  id        String   @id @default(cuid())
  policyId  String
  version   Int
  content   String?
  status    String
  createdAt DateTime @default(now())
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
}

model PolicyChangeRequest {
  id              String   @id @default(cuid())
  policyId        String
  requestedById   String?
  reason          String?
  proposedContent String?
  status          String   @default("requested")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([status])
}

model PolicyReview {
  id        String   @id @default(cuid())
  policyId  String
  reviewerId String?
  dueDate   DateTime?
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([status])
}

model PolicyException {
  id          String   @id @default(cuid())
  policyId    String
  reason      String?
  grantedById String?
  expiresAt   DateTime?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([status])
}

// --- Audit management (distinct from the AuditLog trail) ---

model AuditPlan {
  id            String           @id @default(cuid())
  title         String
  scope         String?
  status        String           @default("planned")
  scheduledAt   DateTime?
  nonconformities Nonconformity[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
}

model Nonconformity {
  id          String            @id @default(cuid())
  auditPlanId String
  description String
  severity    String            @default("minor")
  status      String            @default("open")
  actions     CorrectiveAction[]
  auditPlan   AuditPlan         @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([auditPlanId])
  @@index([status])
}

model CorrectiveAction {
  id              String         @id @default(cuid())
  nonconformityId String
  description     String
  owner           String?
  dueDate         DateTime?
  status          String         @default("open")
  nonconformity   Nonconformity  @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([nonconformityId])
  @@index([status])
}
