DATABASE_URL=postgresql://user:password@localhost:5432/kompro
# Direct (non-pooled) connection used by Prisma for migrations and db push.
# On managed Postgres (e.g. Supabase) this must NOT be the transaction pooler
# (PgBouncer) or schema operations will hang. Use the port 5432 direct URL.
DIRECT_URL=postgresql://user:password@localhost:5432/kompro
JWT_SECRET=change-me-to-a-long-random-string
BACKEND_PORT=5000
NODE_ENV=development
SESSION_TTL_DAYS=30
JWT_TTL=2h
CORS_ORIGIN=http://localhost:5173
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ORG_NAME=My Organization

# Public base URL used to build invitation links (no trailing slash).
APP_URL=http://localhost:5173

# How many hours an invitation link stays valid.
INVITE_TTL_HOURS=72

# SMTP configuration for sending invitation emails. Leave SMTP_HOST empty to
# disable email (user invites will then fail until configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@kompro.local

# Evidence file storage. Leave S3_* empty to store files on the local disk
# under UPLOAD_DIR. Set S3_BUCKET and S3_REGION to use S3-compatible storage
# (AWS S3 or compatible endpoints such as MinIO). The local fallback always
# works with no extra setup.
UPLOAD_DIR=
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Maximum JSON request body size in megabytes.
BODY_LIMIT_MB=1

# How many days audit entries are retained before purge (npm run audit:purge).
AUDIT_RETENTION_DAYS=365

# --- Social/enterprise SSO (OAuth 2.0 Authorization Code + PKCE) ---
# Leave a provider's client id/secret blank to disable it. The login screen
# only shows a button once the corresponding client id and secret are set,
# and the callback rejects sign-ins for unconfigured providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPE=openid email profile

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_SCOPE=openid email profile

# Provision a new Kompro user on first SSO sign-in. Set to 'false' to require
# pre-existing accounts only (SSO then links to the matching verified email).
SSO_AUTO_PROVISION=true

# Optional explicit base URL for the SSO callback (e.g. https://app.example.com).
# When empty the callback URI is derived from the incoming request host so the
# handshake stays on the same origin the browser already uses.
SSO_REDIRECT_BASE=
