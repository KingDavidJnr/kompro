DATABASE_URL=postgresql://user:password@localhost:5432/kompro
JWT_SECRET=change-me-to-a-long-random-string
BACKEND_PORT=5000
NODE_ENV=development
SESSION_TTL_DAYS=30
JWT_TTL=2h
CORS_ORIGIN=http://localhost:5173
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ORG_NAME=My Organization

# Public base URL used to build invitation links (no trailing slash).
APP_URL=http://localhost:5173

# How many hours an invitation link stays valid.
INVITE_TTL_HOURS=72

# SMTP configuration for sending invitation emails. Leave SMTP_HOST empty to
# disable email (user invites will then fail until configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@kompro.local
