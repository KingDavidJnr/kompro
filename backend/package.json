{
  "name": "kompro-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Kompro backend - self-hosted compliance management platform",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "audit:purge": "node scripts/purge-audit.js",
    "notify:due": "node scripts/notify-due.js",
    "test": "cross-env NODE_ENV=test SMTP_HOST=test.local jest",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "maxWorkers": 1,
    "testTimeout": 60000,
    "forceExit": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}
