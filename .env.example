# ============================================================
# Kompro Environment Configuration
# ============================================================
#
# Copy this file to:
#
#   .env
#
# Then replace the placeholder values with your deployment
# configuration.
#
# The root .env is shared by the Kompro frontend and backend.
#
# IMPORTANT:
# Variables prefixed with VITE_ are exposed to the frontend
# application and must never contain secrets.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

# Environment in which Kompro is running.
#
# Common values:
#   development
#   production
#
NODE_ENV=development

# Port on which the Kompro backend will run.
BACKEND_PORT=5000

# Port on which the Vite frontend will run during development.
FRONTEND_PORT=5173


# ============================================================
# DATABASE
# ============================================================

# PostgreSQL connection string.
#
# Kompro uses the organization's own PostgreSQL database.
#
# Example:
# DATABASE_URL=postgresql://username:password@localhost:5432/kompro
#
DATABASE_URL=


# ============================================================
# BACKEND
# ============================================================

# URL used by the frontend to communicate with the Kompro backend.
#
# Development example:
# VITE_BACKEND_URL=http://localhost:5000
#
# Production deployments should use the appropriate backend URL.
#
VITE_BACKEND_URL=


# ============================================================
# GOOGLE AUTHENTICATION
# ============================================================

# Google OAuth client ID.
#
# This value is intentionally prefixed with VITE_ because the
# frontend requires the client ID to initiate Google sign-in.
#
# The corresponding Google client secret must NOT use the
# VITE_ prefix and must remain available only to the backend.
#
VITE_GOOGLE_CLIENT_ID=

# Google OAuth client secret.
#
# Backend only. Do not expose this value to the frontend.
#
GOOGLE_CLIENT_SECRET=


# ============================================================
# MICROSOFT AUTHENTICATION
# ============================================================

# Microsoft OAuth client ID.
#
# This value is intentionally exposed to the frontend because
# the frontend requires it to initiate Microsoft sign-in.
#
VITE_MICROSOFT_CLIENT_ID=

# Microsoft OAuth redirect URI used by the frontend.
#
VITE_MICROSOFT_REDIRECT_URI=

# Microsoft OAuth client secret.
#
# Backend only. Do not expose this value to the frontend.
#
MICROSOFT_CLIENT_SECRET=


# ============================================================
# FRONTEND AUTHENTICATION
# ============================================================

# Controls which authentication methods are available on the
# Kompro login interface.
#
# Supported values:
#
#   password   Email and password authentication
#   google     Google sign-in only
#   microsoft  Microsoft sign-in only
#   all        Email/password, Google, and Microsoft
#   sso        Google and Microsoft sign-in only (no email/password)
#
VITE_AUTH_MODE=all


# ============================================================
# ORGANIZATION
# ============================================================

# Name displayed as the organization's Kompro workspace name.
#
# This is deployment-level configuration.
#
VITE_ORGANIZATION_NAME=
# ============================================================
# BACKEND (auth, sessions, IAM)
# ============================================================

# Secret used to sign session JWTs (HS256). Use a long random string.
JWT_SECRET=

# Lifetime of a session JWT before it must be re-issued.
JWT_TTL=2h

# How many days a DB session remains valid before forced re-login.
SESSION_TTL_DAYS=30

# Comma-separated origins allowed to call the API (CORS, credentials).
CORS_ORIGIN=http://localhost:5173

# Optional initial admin bootstrap (used by prisma seed).
# If set and no admin exists, a user with the admin role is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Default organization name seeded on first run.
ORG_NAME=My Organization
